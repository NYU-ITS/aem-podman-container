# --- Stage 1: Build, Unpack & Warm-Boot Stage ---
FROM eclipse-temurin:11-jdk-jammy AS builder

# Install curl for startup polling
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/aem

COPY author-p4502.jar /opt/aem/author-p4502.jar
COPY license.properties /opt/aem/license.properties
COPY password.properties /opt/aem/password.properties

# 1. Unpack AEM
RUN java -jar /opt/aem/author-p4502.jar -unpack -nointeractive && \
    rm -f /opt/aem/author-p4502.jar

# Warm-Boot AEM with SIGTERM handling fix
RUN java -Xmx4096m -Djava.awt.headless=true -Dsling.run.modes=author,nosamplecontent \
    -jar /opt/aem/crx-quickstart/app/*.jar -p 4502 -nofork & \
    PID=$! && \
    echo "Waiting for AEM to complete initial setup..." && \
    COUNTER=0 && \
    until STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:4502/libs/granite/core/content/login.html) && [ "$STATUS" = "200" ]; do \
      COUNTER=$((COUNTER+10)) && \
      echo "AEM initializing... ($COUNTER sec elapsed) - Current HTTP Status: $STATUS" && \
      sleep 10; \
    done && \
    echo "AEM is fully initialized (HTTP 200 received after $COUNTER seconds). Shutting down cleanly..." && \
    kill -TERM $PID && \
    (wait $PID || true) && \
    rm -rf /opt/aem/crx-quickstart/logs/*

# 3. Save initialized repository to a seed folder for runtime copying
RUN cp -r /opt/aem/crx-quickstart/repository /opt/aem/repository-seed


# --- Stage 2: Runtime Stage ---
FROM eclipse-temurin:11-jre-jammy

RUN groupadd -g 10001 aem && \
    useradd -u 10001 -g aem -d /opt/aem -s /bin/bash aem

WORKDIR /opt/aem

# Copy the unpacked AEM AND the warm seed repository
COPY --chown=aem:aem --from=builder /opt/aem /opt/aem

# Add entrypoint script to populate empty volumes from seed
COPY --chown=aem:aem entrypoint.sh /opt/aem/entrypoint.sh
RUN chmod +x /opt/aem/entrypoint.sh

USER aem
EXPOSE 4502

ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.awt.headless=true -XX:+HeapDumpOnOutOfMemoryError"

ENTRYPOINT ["/opt/aem/entrypoint.sh"]